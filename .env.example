# ============================================================================
# Matteblack — environment configuration
# ============================================================================
# Copy to `.env` and fill in what you need. NOTHING here is required for the
# local desktop build: with LOCAL_MODE the app runs with an embedded database,
# local file storage, no login, and API keys entered in-app under Settings.
#
# Every value below is read from the environment (there is no host that injects
# secrets for you). Do NOT commit your filled-in `.env`.
# ----------------------------------------------------------------------------

# --- Run mode ---------------------------------------------------------------
# LOCAL_MODE=true  -> login-less desktop build: embedded Postgres (PGlite) under
#                     MATTEBLACK_DATA_DIR, files on local disk, single local
#                     user, no billing. This is the default when neither
#                     DATABASE_URL nor WORKOS_API_KEY is set.
# LOCAL_MODE=false -> force the original cloud build (requires the cloud vars
#                     below).
LOCAL_MODE=true

# Where the local build stores its database + uploaded/generated files.
# Defaults to ~/.matteblack. The Electron shell sets this to the app's userData.
# MATTEBLACK_DATA_DIR=

# Backend HTTP port (frontend dev server proxies /api and /auth here).
PORT=3001

# Public base URL of the app (used to build absolute links in emails / Stripe
# redirects). For local dev this is the Vite server.
APP_URL=http://localhost:5000

# ============================================================================
# API keys — in the local build these are entered in-app (Settings ▸ API keys)
# and stored per-device; the env vars below are an optional fallback.
# ============================================================================

# fal.ai — the core image / video / audio generation engine. REQUIRED to
# generate anything. Get a key: https://fal.ai/dashboard/keys
FAL_KEY=

# Anthropic — optional, powers the AI Agent panel and Brand IQ.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# ============================================================================
# Cloud-build only — NOT needed when LOCAL_MODE=true
# ============================================================================

# --- Database (managed Postgres) --------------------------------------------
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- WorkOS AuthKit (authentication) ----------------------------------------
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_COOKIE_PASSWORD=          # 32+ char random string
# WORKOS_REDIRECT_URI=https://your.app/auth/callback
# DEV_AUTH_BYPASS=true             # non-production only: skip WorkOS in dev
# DEV_JWT_SECRET=                  # signs the dev-session cookie

# --- Cloudflare R2 (object storage) -----------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://cdn.your.app

# --- Stripe (payments / credits) --------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_POWER=

# --- Resend (transactional email) -------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=noreply@your.app

# --- Redis (presence + canvas cache; optional, in-memory fallback if unset) --
# REDIS_URL=
# REDIS_URL_DEV=

# --- AWS Rekognition (ClearCheck copyright/moderation; optional) ------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Misc -------------------------------------------------------------------
# SUPERADMIN_DOMAIN=matteblack.io  # emails on this domain get superadmin (cloud)
