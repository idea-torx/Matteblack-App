{
  "name": "matteblack",
  "license": "FSL-1.1-MIT",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external --target=node20",
    "build:mcp": "esbuild server/mcp/index.ts --bundle --platform=node --format=esm --outfile=dist-mcp/index.js --packages=external --target=node20",
    "mcp": "tsx server/mcp/index.ts",
    "server": "npm run build:server && node dist-server/index.js",
    "dev:server:local": "cross-env LOCAL_MODE=true tsx server/index.ts",
    "server:local": "cross-env LOCAL_MODE=true npm run server",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "node --import tsx --test src/lib/mentionCore.test.ts",
    "migrate:r2": "tsx server/migrate-to-r2.ts",
    "electron:prep": "vite build && npm run build:server && npm run build:mcp",
    "electron:dev": "npm run electron:prep && electron .",
    "electron:dist": "npm run electron:prep && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-rekognition": "^3.1014.0",
    "@aws-sdk/client-s3": "^3.1021.0",
    "@electric-sql/pglite": "^0.2.17",
    "@fal-ai/client": "^1.9.4",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/dompurify": "^3.0.5",
    "@types/ioredis": "^4.28.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@workos-inc/node": "^8.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.1",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "flatted": "^3.4.2",
    "idb": "^8.0.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "paper": "^0.12.18",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "picomatch": "^4.0.4",
    "probe-image-size": "^7.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.4",
    "stripe": "^21.0.1",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "wavesurfer.js": "^7.12.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "puppeteer": "^24.43.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
